# Fim de linha estável entre Windows e Linux (evita «arquivo modificado» só por CRLF)
* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.onnx binary
*.traineddata binary
*.png binary
*.ico binary
